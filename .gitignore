# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# See https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
# Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Python virtual environments (for scripts)
.venv/
venv/
__pycache__/
*.pyc
*.pyo

# Coverage reports
*.lcov
coverage/
tarpaulin-report.html

# Benchmark results
criterion/

# Documentation build output
doc/

# Local development files
.env
.env.local
*.local

# Log files
*.log
logs/

# Web frontend
web/node_modules/
web/dist/
web/pkg/
web/.vite/

# Playwright test artifacts
web/playwright-report/
web/test-results/
web/public/data/currency/

# wasm-pack release archives downloaded by CI (never commit them)
wasm-pack-v*/
wasm-pack-v*.tar.gz

# Full per-case output of scripts/competitor-coverage.mjs (1 MB); the compact coverage-baseline.json is committed instead
docs/case-studies/*/results/coverage-results.json

# Scratch directory for downloaded CI run logs and working notes during issue investigation
/ci-logs/
