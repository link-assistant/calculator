// Spelled numbers and arithmetic operator words, one link per surface form.
// Loaded by src/grammar/arithmetic_words.rs (issue #222); add a language by
// adding lines here, no code changes needed.
//
//   (number <lang> <value> '<word>')    a cardinal number word
//   (scale <lang> <factor> '<word>')    multiplies what precedes it (hundred, 十)
//   (operator <lang> <op> '<phrase>')   op is one of + - * / % ^
//
// Multi-word phrases are matched longest-first ("multiplied by" before
// "multiplied"). Matching is case-insensitive, except that an all-uppercase
// word naming a known currency ("DOS", "MIL") stays that currency.
// Spanish "once" (11) is left out: it is already French for ounce.

// ── English ────────────────────────────────────────────────────────────────
(number en 0 'zero')
(number en 1 'one')
(number en 2 'two')
(number en 3 'three')
(number en 4 'four')
(number en 5 'five')
(number en 6 'six')
(number en 7 'seven')
(number en 8 'eight')
(number en 9 'nine')
(number en 10 'ten')
(number en 11 'eleven')
(number en 12 'twelve')
(number en 13 'thirteen')
(number en 14 'fourteen')
(number en 15 'fifteen')
(number en 16 'sixteen')
(number en 17 'seventeen')
(number en 18 'eighteen')
(number en 19 'nineteen')
(number en 20 'twenty')
(number en 30 'thirty')
(number en 40 'forty')
(number en 50 'fifty')
(number en 60 'sixty')
(number en 70 'seventy')
(number en 80 'eighty')
(number en 90 'ninety')
(scale en 100 'hundred')
(scale en 1000 'thousand')
(scale en 1000000 'million')
(scale en 1000000000 'billion')
(operator en + 'plus')
(operator en + 'with')
(operator en - 'minus')
(operator en - 'subtract')
(operator en - 'without')
(operator en * 'times')
(operator en * 'multiplied by')
(operator en * 'multiplied')
(operator en * 'mul')
(operator en / 'divided by')
(operator en / 'divided')
(operator en / 'divide by')
(operator en / 'divide')
(operator en / 'per')
(operator en % 'modulo')
(operator en % 'mod')
(operator en ^ 'to the power of')
(operator en ^ 'power')

